{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Launch Program",
			"program": "${workspaceFolder}/${input:programPath}",
			"runtimeArgs": ["-r", "ts-node/register"],
			"args": ["--serve"],
			"cwd": "${workspaceFolder}",
			"envFile": "${workspaceFolder}/.env",
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/dist/**/*.js"]
		},
		{
			"type": "pwa-msedge",
			"request": "launch",
			"name": "Launch Edge",
			"url": "http://localhost:3000",
			"webRoot": "${workspaceFolder}",
			"runtimeExecutable": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe"
		}
	],
	"inputs": [
		{
			"type": "pickString",
			"id": "programPath",
			"description": "Select the entry point for your program",
			"options": ["src/server.ts"]
		}
	]
}
